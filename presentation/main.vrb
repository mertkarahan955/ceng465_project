\frametitle{Schema Design}
\begin{columns}
    \column{0.48\textwidth}
      \textbf{\texttt{items} collection}
      \begin{lstlisting}[language={}]
{
  key,
  value,
  version,          -- increments on each write
  leader_term,
  last_log_index,
  last_operation_id,
  last_updated,
  deleted           -- soft delete
}
      \end{lstlisting}

    \column{0.48\textwidth}
      \textbf{\texttt{operation\_logs} collection}
      \begin{lstlisting}[language={}]
{
  operation_id,
  operation_type,
  log_index,
  leader_write_time,
  follower_visible_time,
  replication_delay_ms,
  version_before,
  version_after,
  status,           -- pending / visible / timeout
  write_concern
}
      \end{lstlisting}
  \end{columns}

  \begin{block}{Raft-inspired metadata}
    \texttt{leader\_term}, \texttt{log\_index}, \texttt{operation\_id}, and \texttt{version} make update ordering and follower visibility fully observable.
  \end{block}
